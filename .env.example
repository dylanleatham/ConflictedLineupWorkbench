# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: where test cases, images and results are stored (default: ./.festival-tests)
# FESTIVAL_STORAGE_DIR=

# Optional: comma-separated origins allowed to call the API directly (default: Vite dev server)
# CORS_ORIGINS=http://localhost:5173
